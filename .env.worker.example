# ThinkMade worker settings for this Mac (npm run worker:mac -- install). Copy to .env.worker.
# Use the same values as in Vercel. .env.worker is git-ignored; never commit it.
NODE_ENV=production
DATABASE_URL=
GROQ_API_KEY=
# Photos and video frames (free account at openrouter.ai, no card)
OPENROUTER_API_KEY=
# Backup language and vision models when Groq or OpenRouter reach their free limits (Google AI Studio, free, no card)
GEMINI_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: email administrators when an episode is held for review
RESEND_API_KEY=
EMAIL_FROM=
