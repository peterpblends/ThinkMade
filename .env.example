# ThinkMade environment. Copy to .env for local development. All values are optional locally.

# --- API ---
NODE_ENV=development
PORT=8787
# Postgres connection string (Neon in production). Leave unset to use embedded PGlite in .data/pglite.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the web app and of the API (same origin on Vercel).
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
# WebAuthn relying party id: the registrable domain (thinkmade.zicaworld.com in production).
PASSKEY_RP_ID=localhost
# Development only: allow admin routes without two-factor. Never set in production.
ADMIN_SKIP_2FA=

# --- AI providers (all optional locally) ---
# Groq: language models (Qwen3.8-27B, gpt-oss-120b, gpt-oss-20b), Coach Me and voice/video transcription. Free tier, no card.
GROQ_API_KEY=
# Use one local model for every stage instead: DEFAULT_LLM_PROVIDER=ollama, DEFAULT_LLM_MODEL=qwen2.5:7b
# (applies when the database is first created; change models later in Admin → AI models).
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
# OpenRouter: photo and video-frame analysis (Gemma 4, free tier, no card). Groq's free tier has no vision model.
OPENROUTER_API_KEY=
# Google Gemini (AI Studio, free tier, no card): backup for every stage, including photos, when Groq or
# OpenRouter reach their free limits. Strongly recommended in production.
GEMINI_API_KEY=
# Speech: Phonon-31M by default with Kokoro as backup (both local and free). TTS_PROVIDER=kokoro for Kokoro only.
TTS_PROVIDER=
KOKORO_DTYPE=q8
# Where the worker keeps downloaded speech and embedding models (default .data/models)
MODEL_CACHE_DIR=
# Search embeddings: EmbeddingGemma 2 runs on the worker. On Vercel, point the API at the worker's
# embedding server (docs/worker.md); without it, Discover uses text search only.
EMBED_SERVER_URL=
EMBED_SERVER_TOKEN=
# Worker only: serve embeddings to the API on this port (put HTTPS in front of it)
EMBED_SERVER_PORT=
# Web build: set to 1 to skip downloading the on-device speech model (about 67 MB)
SKIP_SPEECH_MODEL=

# --- Storage ---
# Local files (default .data/storage) or Cloudflare R2 / any S3-compatible store
STORAGE_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Email (production) ---
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=ThinkMade <hello@thinkmade.zicaworld.com>
