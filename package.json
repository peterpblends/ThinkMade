{
  "name": "thinkmade",
  "private": true,
  "version": "0.1.0",
  "description": "ThinkMade \u2014 Better Thinking. Made Personal.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c \"#829284,#C56B4E\" \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w packages/db",
    "build:vercel": "npm run build -w apps/web && tsx apps/api/scripts/build-vercel.ts",
    "e2e": "npm run e2e -w apps/web",
    "seed:admin": "npm run seed:admin -w apps/api --",
    "build:icons": "npm run build:icons -w packages/brand",
    "storage:cors": "tsx --env-file-if-exists=.env scripts/storage-cors.ts",
    "worker:mac": "zsh scripts/worker-mac.sh",
    "worker:setup": "zsh scripts/worker-env.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.21.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "sharp@0.35.5": true
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
